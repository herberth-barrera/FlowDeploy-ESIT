<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
  <div>
    <h1 class="h2 mb-1">Asignaturas</h1>
    <p class="text-secondary mb-0">Registra y consulta asignaturas.</p>
  </div>
</div>

<% if (successMessage) { %>
  <div class="alert alert-success" role="status"><%= successMessage %></div>
<% } %>

<% if (errores.length) { %>
  <div class="alert alert-danger" role="alert">
    <p class="fw-semibold mb-1">Revisa estos datos:</p>
    <ul class="mb-0">
      <% errores.forEach((error) => { %><li><%= error %></li><% }); %>
    </ul>
  </div>
<% } %>

<section class="card shadow-sm mb-4" aria-labelledby="course-form-title">
  <div class="card-body">
    <h2 class="h5" id="course-form-title">Registrar asignatura</h2>
    <form action="/courses" method="post" class="row g-3">
      <div class="col-md-4">
        <label class="form-label" for="code">Código</label>
        <input class="form-control" id="code" name="code" required minlength="2" maxlength="12" value="<%= course.code || '' %>">
      </div>
      <div class="col-md-5">
        <label class="form-label" for="name">Nombre</label>
        <input class="form-control" id="name" name="name" required minlength="2" maxlength="100" value="<%= course.name || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="credits">Créditos</label>
        <input class="form-control" id="credits" name="credits" type="number" required min="1" max="10" step="1" value="<%= course.credits || '' %>">
      </div>
      <div class="col-12">
        <button class="btn btn-primary" type="submit">Guardar asignatura</button>
      </div>
    </form>
  </div>
</section>

<section aria-labelledby="course-list-title">
  <h2 class="h5 mb-3" id="course-list-title">Asignaturas registradas</h2>
  <% if (courses.length === 0) { %>
    <p class="text-secondary">Aún no hay asignaturas registradas.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle bg-white">
        <thead><tr><th>Código</th><th>Nombre</th><th>Créditos</th><th>Estado</th><th>Acción</th></tr></thead>
        <tbody>
          <% courses.forEach((courseRecord) => { %>
            <tr>
              <td><%= courseRecord.code %></td>
              <td><%= courseRecord.name %></td>
              <td><%= courseRecord.credits %></td>
              <td><span class="badge <%= courseRecord.active ? 'text-bg-success' : 'text-bg-secondary' %>"><%= courseRecord.active ? 'Activo' : 'Inactivo' %></span></td>
              <td>
                <form action="/courses/<%= courseRecord.id %>/toggle" method="post">
                  <button class="btn btn-sm <%= courseRecord.active ? 'btn-outline-secondary' : 'btn-outline-success' %>" type="submit"><%= courseRecord.active ? 'Desactivar' : 'Activar' %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
